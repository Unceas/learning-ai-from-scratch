# ==============================================================================
# AI Research Assistant - Development Environment Configuration Template
# ==============================================================================

# Application Environment (development | test | production)
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Research Assistant (Dev)"
APP_VERSION=1.0.0

# Database Configuration (SQLite in dev, PostgreSQL in prod)
DATABASE_URL=sqlite:///./app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

# Distributed Queue & Caching (Redis)
REDIS_URL=redis://localhost:6379/0
USE_DISTRIBUTED_QUEUE=false
DISTRIBUTED_QUEUE_NAME=document-indexing
DISTRIBUTED_CACHE_ENABLED=false
DISTRIBUTED_CACHE_TTL=300

# Storage & File Uploads
STORAGE_TYPE=local
STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_MB=20
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=ai-research-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_secure_123

# Vector Database (ChromaDB)
CHROMA_PATH=./document_db
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=
CHROMA_SERVER_SSL=false
MEMORY_PATH=./memory_db

# AI Models & Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gemini-2.5-flash

# Authentication & Security
JWT_SECRET_KEY=dev-secret-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Provider API Key
LLM_API_KEY=replace-with-actual-provider-key
LLM_TIMEOUT_SECONDS=60
MAX_LLM_CONCURRENCY=8

# Cache Capacities
EMBEDDING_CACHE_ENTRIES=512
RETRIEVAL_CACHE_ENTRIES=256

# Frontend Build Time Injection
VITE_API_BASE_URL=http://localhost:8000
