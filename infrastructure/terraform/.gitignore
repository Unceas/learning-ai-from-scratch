# Terraform working directory
.terraform/

# State files
*.tfstate
*.tfstate.*

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive plan files
*.tfplan
