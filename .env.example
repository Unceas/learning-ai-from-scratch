# ==============================================================================
# AI Research Assistant - Development Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Research Assistant (Dev)"
APP_VERSION=1.0.0

DATABASE_URL=sqlite:///./app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

REDIS_URL=redis://localhost:6379/0
USE_DISTRIBUTED_QUEUE=false
DISTRIBUTED_QUEUE_NAME=document-indexing
DISTRIBUTED_CACHE_ENABLED=false
DISTRIBUTED_CACHE_TTL=300

STORAGE_TYPE=local
STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_MB=20
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=ai-research-documents

CHROMA_PATH=./document_db
MEMORY_PATH=./memory_db

EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gemini-2.5-flash

JWT_SECRET_KEY=dev-secret-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

LLM_API_KEY=replace-with-actual-provider-key
LLM_TIMEOUT_SECONDS=60
MAX_LLM_CONCURRENCY=8

VITE_API_BASE_URL=http://localhost:8000
